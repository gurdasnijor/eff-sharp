<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- One test file per upstream module, mirroring effect-smol/test naming
       (Effect.test.ts -> EffectTests.fs). See PORTING.md for full coverage. -->
  <ItemGroup>
    <Compile Include="EffectTests.fs" />
    <Compile Include="CauseTests.fs" />
    <Compile Include="ExitTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Effect/Effect.fsproj" />
  </ItemGroup>

</Project>
