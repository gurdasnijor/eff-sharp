<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- One test file per upstream module, mirroring effect-smol/test naming
       (Effect.test.ts -> EffectTests.fs). See PORTING.md for full coverage. -->
  <ItemGroup>
    <Compile Include="EffectTests.fs" />
    <Compile Include="NodePlatformTests.fs" />
    <Compile Include="FileSystemTests.fs" />
    <Compile Include="NodeStreamTests.fs" />
    <Compile Include="ChildProcessSpawnerTests.fs" />
    <Compile Include="CauseTests.fs" />
    <Compile Include="ExitTests.fs" />
    <Compile Include="IntegrationTests.fs" />
    <Compile Include="StreamTests.fs" />
    <Compile Include="SinkTests.fs" />
    <Compile Include="ChannelTests.fs" />
    <Compile Include="LayerTests.fs" />
    <Compile Include="FiberTests.fs" />
    <Compile Include="Kernel2Tests.fs" />
    <Compile Include="Kernel2bTests.fs" />
    <!-- w2-di: Context / Scope / Clock vertical -->
    <Compile Include="ContextTests.fs" />
    <Compile Include="ScopeTests.fs" />
    <Compile Include="ClockTests.fs" />
    <!-- w5-runtime: Runtime bundle + run* family -->
    <Compile Include="RuntimeTests.fs" />
    <!-- leaf5: traits -->
    <Compile Include="EquivalenceTests.fs" />
    <Compile Include="OrderTests.fs" />
    <Compile Include="BrandTests.fs" />
    <Compile Include="HashTests.fs" />
    <Compile Include="EqualTests.fs" />
    <!-- leaf2: immutable hashing collections -->
    <Compile Include="HashMapTests.fs" />
    <Compile Include="HashSetTests.fs" />
    <Compile Include="HashRingTests.fs" />
    <!-- leaf3: mutable collections -->
    <Compile Include="MutableHashMapTests.fs" />
    <Compile Include="MutableHashSetTests.fs" />
    <Compile Include="MutableListTests.fs" />
    <Compile Include="MutableRefTests.fs" />
    <!-- leaf6: encoding / data -->
    <Compile Include="DataTests.fs" />
    <Compile Include="RedactedTests.fs" />
    <Compile Include="EncodingTests.fs" />
    <Compile Include="JsonPointerTests.fs" />
    <Compile Include="JsonPatchTests.fs" />
    <!-- leaf1: native sequence / collection ports -->
    <Compile Include="ChunkTests.fs" />
    <Compile Include="TrieTests.fs" />
    <Compile Include="GraphTests.fs" />
    <!-- leaf4: numeric / time -->
    <Compile Include="BigDecimalTests.fs" />
    <Compile Include="DurationTests.fs" />
    <Compile Include="DateTimeTests.fs" />
    <Compile Include="CronTests.fs" />
    <!-- wave4: Schedule -->
    <Compile Include="ScheduleTests.fs" />
    <!-- w2-leavesa: algebraic leaves -->
    <Compile Include="CombinerTests.fs" />
    <Compile Include="ReducerTests.fs" />
    <Compile Include="DifferTests.fs" />
    <Compile Include="NonEmptyIterableTests.fs" />
    <!-- w2-ref: fiber-safe mutable state -->
    <Compile Include="RefTests.fs" />
    <Compile Include="SynchronizedRefTests.fs" />
    <!-- w2-deferred: synchronization primitives -->
    <Compile Include="DeferredTests.fs" />
    <Compile Include="LatchTests.fs" />
    <!-- w2-leavesb: utility leaves -->
    <Compile Include="RedactableTests.fs" />
    <Compile Include="FormatterTests.fs" />
    <Compile Include="PlatformErrorTests.fs" />
    <Compile Include="PrimaryKeyTests.fs" />
    <Compile Include="RegExpTests.fs" />
    <!-- w6: pool -->
    <Compile Include="PoolTests.fs" />
    <!-- w5: async queue -->
    <Compile Include="QueueTests.fs" />
    <!-- w4-svc: services -->
    <Compile Include="RandomTests.fs" />
    <Compile Include="ConsoleTests.fs" />
    <!-- w6-terminal: CLI terminal service -->
    <Compile Include="TerminalTests.fs" />
    <Compile Include="CryptoTests.fs" />
    <Compile Include="ScopedRefTests.fs" />
    <Compile Include="RcRefTests.fs" />
    <!-- w3-stm: transactional memory -->
    <Compile Include="TxRefTests.fs" />
    <Compile Include="TxChunkTests.fs" />
    <Compile Include="TxHashMapTests.fs" />
    <Compile Include="TxHashSetTests.fs" />
    <Compile Include="TxDeferredTests.fs" />
    <!-- w4-stml: STM leaves -->
    <Compile Include="TxPriorityQueueTests.fs" />
    <Compile Include="TxSemaphoreTests.fs" />
    <Compile Include="TxReentrantLockTests.fs" />
    <!-- w3-frontier-b: Filter -> Pull -> Take -->
    <Compile Include="FilterTests.fs" />
    <Compile Include="PullTests.fs" />
    <Compile Include="TakeTests.fs" />
    <!-- w3-frontier-a: numeric / schema / request leaves -->
    <Compile Include="BigIntTests.fs" />
    <Compile Include="JsonSchemaTests.fs" />
    <Compile Include="RequestTests.fs" />
    <Compile Include="RequestResolverTests.fs" />
    <!-- w4-stmq: transactional queue + pub/sub -->
    <Compile Include="TxQueueTests.fs" />
    <Compile Include="TxPubSubTests.fs" />
    <!-- w4-conc: concurrency hubs -->
    <Compile Include="PubSubTests.fs" />
    <Compile Include="PartitionedSemaphoreTests.fs" />
    <!-- w4-schema: type-first codec -->
    <Compile Include="SchemaTests.fs" />
    <!-- w5: counting semaphore -->
    <Compile Include="SemaphoreTests.fs" />
    <!-- w5-caches -->
    <Compile Include="CacheTests.fs" />
    <Compile Include="ScopedCacheTests.fs" />
    <!-- w5-resource: refreshable scoped value -->
    <Compile Include="ResourceTests.fs" />
    <!-- w5-fibercoll: fiber-supervision containers -->
    <Compile Include="FiberHandleTests.fs" />
    <Compile Include="FiberSetTests.fs" />
    <Compile Include="FiberMapTests.fs" />
    <!-- w5-rcmap: reference-counted map of scoped resources -->
    <Compile Include="RcMapTests.fs" />
    <!-- w6-path -->
    <Compile Include="PathTests.fs" />
    <!-- w6-subref: Ref/STM-ref whose changes publish as a Stream -->
    <Compile Include="SubscriptionRefTests.fs" />
    <Compile Include="TxSubscriptionRefTests.fs" />
    <!-- w6-lruntime: Layer-runtime modules -->
    <Compile Include="ManagedRuntimeTests.fs" />
    <Compile Include="ExecutionPlanTests.fs" />
    <Compile Include="LayerMapTests.fs" />
    <!-- w6: observability metrics -->
    <Compile Include="MetricTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Effect/Effect.fsproj" />
    <ProjectReference Include="../../src/Effect.Platform.Node/Effect.Platform.Node.fsproj" />
  </ItemGroup>

</Project>
