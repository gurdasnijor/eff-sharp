<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fable-only JS runtime test harness.

       This compiles the Fable-ready core, test support, and the F# specs to ESM,
       then Vitest executes the generated JS on Node. -->
  <PropertyGroup>
    <EffectSrcDir>$(MSBuildThisFileDirectory)../src/Effect/</EffectSrcDir>
    <EffectPlatformNodeSrcDir>$(MSBuildThisFileDirectory)../src/Effect.Platform.Node/</EffectPlatformNodeSrcDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" />
    <PackageReference Include="Fable.Promise" />
  </ItemGroup>

  <!-- the Fable-ready core -->
  <Import Project="$(EffectSrcDir)Effect.Sources.props" />

  <ItemGroup>
    <!-- Test infrastructure + Vitest facade. These live under test/support so
         the Node/Vitest harness owns the whole test-only surface. -->
    <Compile Include="support/TestClock.fs" />
    <Compile Include="support/Vitest.fs" />

    <!-- Node platform modules under test. The Vitest harness runs on Node, so
         platform specs compile the real Fable/Node implementation directly. -->
    <Compile Include="$(EffectPlatformNodeSrcDir)NodeFileSystem.fs" />
    <Compile Include="$(EffectPlatformNodeSrcDir)Mime.fs" />
    <Compile Include="$(EffectPlatformNodeSrcDir)NodePath.fs" />
    <Compile Include="$(EffectPlatformNodeSrcDir)NodeCrypto.fs" />
    <Compile Include="$(EffectPlatformNodeSrcDir)NodeStream.fs" />
    <Compile Include="$(EffectPlatformNodeSrcDir)NodeSink.fs" />
    <Compile Include="$(EffectPlatformNodeSrcDir)NodeMultipart.fs" />
    <Compile Include="$(EffectPlatformNodeSrcDir)NodeHttpIncomingMessage.fs" />
    <Compile Include="$(EffectPlatformNodeSrcDir)NodeHttpServerRequest.fs" />
    <Compile Include="$(EffectPlatformNodeSrcDir)NodeHttpPlatform.fs" />
    <Compile Include="$(EffectPlatformNodeSrcDir)NodeChildProcessSpawner.fs" />
    <Compile Include="$(EffectPlatformNodeSrcDir)NodeHttpClient.fs" />
    <Compile Include="$(EffectPlatformNodeSrcDir)NodeHttpServer.fs" />
    <Compile Include="$(EffectPlatformNodeSrcDir)Undici.fs" />
    <Compile Include="$(EffectPlatformNodeSrcDir)NodeRuntime.fs" />
    <Compile Include="$(EffectPlatformNodeSrcDir)NodePlatform.fs" />

    <!-- Specs self-register through Effect.Vitest. The glob keeps future ports
         conflict-free: adding a spec does not require editing this project. -->
    <Compile Include="*Spec.fs" />
  </ItemGroup>

</Project>
