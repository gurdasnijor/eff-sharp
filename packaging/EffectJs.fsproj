<Project Sdk="Microsoft.NET.Sdk">

  <!-- JS/TS-consumer view of the eff-sharp core: the same src/Effect modules,
       MINUS the STM Tx* family (depends on TxRef, not yet Fable-ready) and the
       .NET-only TestClock helper. Fable emits this to TypeScript (dist/).
       The file list is the canonical Effect.Sources.props with the two excluded
       subsets Removed, so it tracks the core automatically instead of drifting. -->
  <PropertyGroup>
    <!-- TargetFramework inherited from the repo-root Directory.Build.props. -->
    <EffectSrcDir>$(MSBuildThisFileDirectory)../src/Effect/</EffectSrcDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- the #if FABLE_COMPILER interop in Formatter/Path/Terminal needs Fable.Core -->
    <PackageReference Include="Fable.Core" />
  </ItemGroup>

  <Import Project="$(EffectSrcDir)Effect.Sources.props" />

  <ItemGroup>
    <!-- STM Tx* family (TxRef-based, not yet Fable-ready). TestClock is no longer
         in the core list (it moved to the Effect.Testing assembly), so no Remove. -->
    <Compile Remove="$(EffectSrcDir)Tx*.fs" />
  </ItemGroup>

</Project>
