{
  "name": "eff-sharp",
  "version": "0.0.0",
  "description": "eff-sharp — a native F# port of Effect, compiled to TypeScript via Fable for Node/TS consumers (e.g. fluent-firegrid).",
  "type": "module",
  "exports": {
    ".": "./dist/src/Effect/Effect.ts",
    "./*": "./dist/src/Effect/*.ts",
    "./platform-node/*": "./dist/src/Effect.Platform.Node/*.ts",
    "./Effect.Platform.Node/*": "./dist/src/Effect.Platform.Node/*.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "dotnet fable EffectJs.fsproj --lang typescript -o dist --optimize",
    "smoke": "npx tsx consume.ts"
  }
}
