<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Effect</RootNamespace>
  </PropertyGroup>

  <!-- Smallest viable slice of the eff-sharp core to evaluate an effect
       end-to-end via Fable. Files referenced READ-ONLY by path from ../src/Effect;
       the real Effect.fsproj is untouched. Compile order mirrors the real one. -->
  <!-- Phase 1: the Fable shims now live in the REAL src/Effect files, guarded by
       `#if FABLE_COMPILER`. This harness compiles those real files (Fable defines
       FABLE_COMPILER) to prove the core slice still compiles + runs on Node. The
       old patched/ copies are gone. -->
  <ItemGroup>
    <Compile Include="../src/Effect/Cause.fs" />
    <Compile Include="../src/Effect/Exit.fs" />
    <Compile Include="../src/Effect/Context.fs" />
    <Compile Include="../src/Effect/Effect.fs" />
    <Compile Include="../src/Effect/Scope.fs" />
    <Compile Include="../src/Effect/Fiber.fs" />
    <Compile Include="../src/Effect/Runtime.fs" />
    <Compile Include="../src/Effect/MutableRef.fs" />
    <Compile Include="../src/Effect/Ref.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
