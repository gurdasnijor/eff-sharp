<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>EffSharp</AssemblyName>
    <RootNamespace>Effect</RootNamespace>
    <PackageId>EffSharp</PackageId>
    <Version>0.0.1-alpha.1</Version>
    <Authors>gurdasnijor</Authors>
    <Description>Effect-style runtime and libraries for F# and Fable.</Description>
    <PackageTags>fable-javascript</PackageTags>
    <FablePackageType>library</FablePackageType>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/gurdasnijor/eff-sharp</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.301" />
    <PackageReference Include="Fable.Core" Version="5.1.0" />
    <PackageReference Include="Fable.Package.SDK" Version="1.3.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Fable.Promise" Version="3.2.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Cause.fs" />
    <Compile Include="Exit.fs" />
    <Compile Include="Context.fs" />
    <Compile Include="Effect.fs" />
    <Compile Include="Option.fs" />
