<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>EffSharp</AssemblyName>
    <RootNamespace>Effect</RootNamespace>
  </PropertyGroup>

  <!-- Compile order is dependency order. Mirrors effect-smol module names. -->
  <ItemGroup>
    <!-- Slice 2: error model (compiles first — the slice-3 async core builds on it) -->
    <Compile Include="Cause.fs" />
    <Compile Include="Exit.fs" />
    <!-- w2-di: Context is a plain typed map (no Effect dep), so it precedes the core
         and the async core wires `Effect.service` / `Effect.provideService` on top. -->
    <Compile Include="Context.fs" />
    <!-- Slice 1+3: async Effect core (Reader over Async<Exit>) -->
    <Compile Include="Effect.fs" />
    <!-- Slice 3-4 / w2-di: runtime / concurrency / scoping -->
    <Compile Include="Scope.fs" />
    <Compile Include="Fiber.fs" />
    <Compile Include="Runtime.fs" />
    <!-- Slice 5: dependency injection -->
    <Compile Include="Layer.fs" />
    <!-- Slice 6: higher-level -->
    <!-- w6-streaming: Sink folds over Effect only, so it precedes Stream (which gains Stream.run) -->
    <Compile Include="Sink.fs" />
    <Compile Include="Stream.fs" />
    <!-- w6-streaming: minimal output-writer Channel (bridges to/from Stream) -->
    <Compile Include="Channel.fs" />
    <!-- leaf5: traits -->
    <Compile Include="Equivalence.fs" />
    <Compile Include="Order.fs" />
    <Compile Include="Brand.fs" />
    <Compile Include="Hash.fs" />
    <Compile Include="Equal.fs" />
    <Compile Include="LogLevel.fs" />
    <Compile Include="Scheduler.fs" />
    <Compile Include="References.fs" />
    <Compile Include="Tracer.fs" />
    <Compile Include="Logger.fs" />
    <!-- leaf2: immutable hashing collections -->
    <Compile Include="HashMap.fs" />
    <Compile Include="HashSet.fs" />
    <Compile Include="HashRing.fs" />
    <!-- leaf3: mutable collections -->
    <Compile Include="MutableHashMap.fs" />
    <Compile Include="MutableHashSet.fs" />
    <Compile Include="MutableList.fs" />
    <Compile Include="MutableRef.fs" />
    <!-- leaf6: encoding / data -->
    <Compile Include="Data.fs" />
    <Compile Include="Redacted.fs" />
    <Compile Include="Encoding.fs" />
    <Compile Include="JsonPointer.fs" />
    <Compile Include="JsonPatch.fs" />
    <!-- leaf1: native sequence / collection ports -->
    <Compile Include="Chunk.fs" />
    <Compile Include="Trie.fs" />
    <Compile Include="Graph.fs" />
    <!-- leaf4: numeric / time (standalone, structural equality) -->
    <Compile Include="BigDecimal.fs" />
    <Compile Include="Duration.fs" />
    <Compile Include="DateTime.fs" />
    <Compile Include="Cron.fs" />
    <!-- wave4: Schedule (decision machine over Duration / Cron / DateTime) -->
    <Compile Include="Schedule.fs" />
    <!-- w2-leavesa: algebraic leaves (Combiner depends on Order above; Reducer on Combiner) -->
    <Compile Include="Combiner.fs" />
    <Compile Include="Reducer.fs" />
    <Compile Include="Differ.fs" />
    <Compile Include="NonEmptyIterable.fs" />
    <!-- w2-ref: fiber-safe mutable state (build on Effect + MutableRef) -->
    <Compile Include="Ref.fs" />
    <Compile Include="SynchronizedRef.fs" />
    <!-- w2-deferred: one-shot completion + reusable gate (only depend on Effect core) -->
    <Compile Include="Deferred.fs" />
    <Compile Include="Latch.fs" />
    <!-- w2-di: Clock depends on Duration + Context, so it compiles after them -->
    <Compile Include="Clock.fs" />
    <!-- w2-leavesb: utility leaves (Formatter depends on Redactable) -->
    <Compile Include="Redactable.fs" />
    <Compile Include="Formatter.fs" />
    <!-- w4-schema: type-first codec (needs JsonPatch.Json + Formatter above) -->
    <Compile Include="Schema.fs" />
    <Compile Include="PlatformError.fs" />
    <Compile Include="PrimaryKey.fs" />
    <Compile Include="RegExp.fs" />
    <!-- w4-svc: services (Random/Console over Context; Crypto over PlatformError+Clock;
         ScopedRef/RcRef over Scope+SynchronizedRef) -->
    <Compile Include="Random.fs" />
    <Compile Include="Console.fs" />
    <!-- w6-terminal: CLI terminal service over Context + PlatformError (+ Layer) -->
    <Compile Include="Terminal.fs" />
    <Compile Include="Crypto.fs" />
    <Compile Include="ScopedRef.fs" />
    <Compile Include="RcRef.fs" />
    <!-- w3-stm: transactional memory (TxRef engine, then collections on top) -->
    <Compile Include="TxRef.fs" />
    <Compile Include="TxChunk.fs" />
    <Compile Include="TxHashMap.fs" />
    <Compile Include="TxHashSet.fs" />
    <Compile Include="TxDeferred.fs" />
    <!-- w4-stml: STM leaves on the TxRef engine -->
    <Compile Include="TxPriorityQueue.fs" />
    <Compile Include="TxSemaphore.fs" />
    <Compile Include="TxReentrantLock.fs" />
    <!-- w3-frontier-b: Filter -> Pull -> Take (stream substrate) -->
    <Compile Include="Filter.fs" />
    <Compile Include="Pull.fs" />
    <Compile Include="Take.fs" />
    <!-- w3-frontier-a: numeric / schema / request leaves -->
    <Compile Include="BigInt.fs" />
    <Compile Include="JsonSchema.fs" />
    <Compile Include="Request.fs" />
    <!-- w6-reqresolver: batched request resolution on Request -->
    <Compile Include="RequestResolver.fs" />
    <!-- w4-stmq: transactional queue + pub/sub (build on TxRef/TxChunk) -->
    <Compile Include="TxQueue.fs" />
    <Compile Include="TxPubSub.fs" />
    <!-- w4-conc: concurrency hubs -->
    <Compile Include="PubSub.fs" />
    <Compile Include="PartitionedSemaphore.fs" />
    <!-- w5: counting semaphore -->
    <Compile Include="Semaphore.fs" />
    <!-- w5-caches: keyed memoization (on Deferred / MutableHashMap / Clock / Scope) -->
    <Compile Include="Cache.fs" />
    <Compile Include="ScopedCache.fs" />
    <!-- w5-resource: refreshable scoped value (ScopedRef + Schedule) -->
    <Compile Include="Resource.fs" />
    <!-- w5-fibercoll: fiber-supervision containers (on Fiber/Deferred/Scope) -->
    <Compile Include="FiberHandle.fs" />
    <Compile Include="FiberSet.fs" />
    <Compile Include="FiberMap.fs" />
    <!-- w5: async queue (Deferred/MutableList over a lock-guarded buffer) -->
    <Compile Include="Queue.fs" />
    <!-- w5-rcmap: reference-counted map of scoped resources (on Deferred/MutableHashMap/Clock/Scope/Fiber) -->
    <Compile Include="RcMap.fs" />
    <!-- w6-path: file-path service + POSIX layer (on Context/Layer/PlatformError) -->
    <Compile Include="Path.fs" />
    <!-- w6-subref: Ref whose changes publish as a Stream (PubSub + Semaphore + Stream) -->
    <Compile Include="SubscriptionRef.fs" />
    <Compile Include="TxSubscriptionRef.fs" />
    <!-- w6-lruntime: Layer-runtime modules (on Layer/Runtime/Schedule/RcMap) -->
    <Compile Include="ManagedRuntime.fs" />
    <Compile Include="ExecutionPlan.fs" />
    <Compile Include="LayerMap.fs" />
    <!-- w6: pooled resource manager (fixed-size core on Queue/Scope) -->
    <Compile Include="Pool.fs" />
    <!-- w6: observability metrics -->
    <Compile Include="Metric.fs" />
  </ItemGroup>

</Project>
