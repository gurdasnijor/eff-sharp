<Project Sdk="Microsoft.NET.Sdk">

  <!-- Effect.Testing — test infrastructure (TestClock; later TestConsole/TestSchema/
       FastCheck), the F# analogue of effect-smol's effect/testing/ subpath. NOT part
       of the shipped core: referenced only by the test suite and the Effect.Vitest
       test runtime. Built on Cell, so it is Fable-portable.
       TargetFramework is inherited from the repo-root Directory.Build.props. -->
  <PropertyGroup>
    <AssemblyName>EffSharp.Testing</AssemblyName>
    <RootNamespace>Effect</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestClock.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Effect/Effect.fsproj" />
  </ItemGroup>

</Project>
